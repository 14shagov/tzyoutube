# Copy to .env and fill with real values (deploy.sh does this automatically).
# All values below are fictitious placeholders.

# Application
APP_ENV=dev
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret

# PostgreSQL
POSTGRES_PASSWORD=change-me-pg-password

# S3 storage (Silo — MinIO fork; keeps MINIO_* variable names).
# S3_SECRET_KEY is the single secret for silo AND its clients (web,
# worker): compose maps it to MINIO_ROOT_PASSWORD. Never define a
# separate MINIO_ROOT_PASSWORD — signature mismatch follows.
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-secret
# Host visible to the browser for presigned video URLs. Presigning is
# offline; nginx forwards Host as-is so the signature stays valid.
# On a VM set it to your public host (same as ALLOWED_ORIGINS, no scheme):
# S3_PUBLIC_ENDPOINT=203.0.113.10
S3_PUBLIC_ENDPOINT=localhost
# Region passed explicitly to BOTH Minio clients (web/worker) and to the
# silo server (MINIO_REGION in docker-compose). Without it minio-py does a
# GetBucketLocation network call on every presigned URL — which fails from
# inside the web container. Default us-east-1 matches MinIO's default.
S3_REGION=us-east-1

# Limits (optional, defaults shown)
# MAX_UPLOAD_SIZE=536870912
# PRESIGNED_TTL_SECONDS=14400

# CSRF allowed origins (comma separated; scheme + host + optional port).
# Must list every public address the app is reachable at. Defaults work
# for local docker compose; on a VM set it to your IP or domain, e.g.:
# ALLOWED_ORIGINS=http://203.0.113.10  or  https://video.example.com
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Cookies: set COOKIE_SECURE=true ONLY when serving over HTTPS; on plain
# HTTP the browser would refuse to store the session cookie.
# COOKIE_SECURE=false
